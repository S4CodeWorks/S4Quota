{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S4Quota",
  "version": "0.1.0",
  "identifier": "com.s4codeworks.s4quota",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "S4Quota",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": true,
        "visible": true
      },
      {
        "label": "compact",
        "title": "S4Quota Compact",
        "width": 304,
        "height": 120,
        "minWidth": 280,
        "minHeight": 112,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.local data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.local http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
